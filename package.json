{
  "name": "script-to-clips",
  "version": "1.0.0",
  "description": "SaaS for processing scripts into clips using Pexels API",
  "main": "dist/server.js",
  "author": {
    "name": "Francis Faniku",
    "email": "fanikufran6@gmail.com"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "dev": "nodemon --watch server.ts --watch routes --watch utils --ext ts,js,ejs,css --exec \"npm run build && node dist/server.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^5.3.1",
    "axios": "^1.4.0",
    "dotenv": "^16.0.3",
    "ejs": "^5.0.2",
    "express": "^4.18.2",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
